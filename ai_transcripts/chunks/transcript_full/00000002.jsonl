rn false;\n138:   policy::path_parser::CheckUserDataDirPolicy(&user_data_dir);\n139: \n140:   HWND chrome = FindRunningChromeWindow(user_data_dir);\n141:   if (!chrome)\n142:     return false;\n143:   return AttemptToNotifyRunningChrome(chrome) == NotifyChromeResult::kSuccess;\n144: }\n145: \n146: // Returns true if the child process |command_line| contains a /prefetch:#\n147: // argument where # is in [1, 8] prior to Win11 and [1,16] for it and later.\n148: // The intent of the function is to ensure that all child processes have a\n149: // /prefetch:N cmd line arg in the required range.\n150: // No child process shall have /prefetch:0 or it will interefere with the main"}
