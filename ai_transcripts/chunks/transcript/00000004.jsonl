rome_exe, '--headless=new', '--inject-candidate-id=JOANTHEDON', 'http://127.0.0.1:8989/with_canary'])\\ntime.sleep(4)\\np.terminate()\\n\\n# Test 2: Without --inject-candidate-id\\nprint('Running Chrome without switch...')\\np2 = subprocess.Popen([chrome_exe, '--headless=new', 'http://127.0.0.1:8989/without_canary'])\\ntime.sleep(4)\\np2.terminate()\\n\\nserver.shutdown()\\n\\nprint('=== Test Results ===')\\nif '/with_canary' in received_headers:\\n    h = received_headers['/with_canary']\\n    canary = h.get('X-Candidate-Canary') or h.get('x-candidate-canary')\\n    print('With canary header:', canary)\\nelse:\\n    print('Error: /with_canary was not fetched')\\n\\nif '/without_canary' in received_headers:\\n    h2 = received_headers['without_canary'] if 'without_canary' in received_headers else received_headers['/without_canary']\\n    canary2 = h2.get('X-Candidate-Canary') or h2.get('x-candidate-canary')\\n    print('Without switch header:', canary2)\\nelse:\\n    print('Error: /without_canary was not fetched')\\n\\\"\"","WaitMsBeforeAsync":"10000","toolSummary":"\"Test header injection with local server\""}}]}
